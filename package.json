{
  "name": "kaoyan-408-score-boost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run build:shared && node --test",
    "start": "node server.js",
    "prestart": "npm run build:web",
    "postinstall": "npm run build:shared",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:deployed": "node scripts/verify-deployed.mjs",
    "verify:graph-convergence": "node scripts/verify-graph-convergence.mjs",
    "verify:node-quest": "node scripts/verify-node-quest.mjs",
    "verify:full-student": "node scripts/verify-full-student.mjs",
    "verify:deep-interactions": "node scripts/verify-deep-interactions.mjs",
    "verify:p0-student": "node scripts/verify-p0-student-loop.mjs",
    "verify:pdf-runtime-tools": "node scripts/verify-pdf-runtime-tools.mjs",
    "verify:api-build-layout": "npm run build:api && node scripts/verify-api-build-layout.mjs",
    "validate:env": "node scripts/validate-environment.mjs",
    "validate:env:development": "node scripts/validate-environment.mjs --file .env.development.example",
    "prod:config": "docker compose --env-file .env.production -f compose.production.yml config",
    "prod:up": "docker compose --env-file .env.production -f compose.production.yml up -d --build --wait",
    "prod:status": "docker compose --env-file .env.production -f compose.production.yml ps",
    "prod:logs": "docker compose --env-file .env.production -f compose.production.yml logs --tail=200",
    "prod:https:config": "docker compose --env-file .env.production -f compose.production.yml -f compose.https.yml config",
    "prod:https:up": "docker compose --env-file .env.production -f compose.production.yml -f compose.https.yml up -d --build --wait",
    "prod:https:status": "docker compose --env-file .env.production -f compose.production.yml -f compose.https.yml ps",
    "prod:https:logs": "docker compose --env-file .env.production -f compose.production.yml -f compose.https.yml logs --tail=200",
    "check:local": "node --test && node scripts/verify-ui.mjs",
    "predeploy": "npm test && npm run verify:api-build-layout",
    "build:shared": "npm run build -w packages/shared",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:migration": "npm run build:api && node scripts/dev-migration.mjs",
    "build:web": "npm run build:shared && npm run build -w apps/web",
    "build:api": "npm run build:shared && npm run build -w apps/api",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:backup": "node scripts/backup-postgres.mjs",
    "db:backup:verify": "node scripts/verify-postgres-backup.mjs",
    "db:restore": "node scripts/restore-postgres.mjs",
    "seed:408": "node scripts/seed-408-v2.mjs",
    "seed:knowledge-map": "node scripts/seed-knowledge-point-map.mjs",
    "verify:408-data": "node scripts/verify-408-data.mjs",
    "questions:import": "node scripts/import-questions.mjs",
    "questions:import:dry-run": "node scripts/import-questions.mjs --dry-run",
    "questions:generate-starter": "node scripts/generate-starter-320-questions.mjs",
    "users:create-teacher": "node scripts/create-teacher-user.mjs --role teacher",
    "users:create-admin": "node scripts/create-teacher-user.mjs --role admin",
    "smoke:migration": "npm run build:api && npm run build:web && node scripts/smoke-migration.mjs",
    "smoke:staging": "node scripts/staging-smoke.mjs",
    "smoke:production-compose": "node scripts/smoke-production-compose.mjs",
    "db:test:up": "docker compose -f compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f compose.test.yml down -v",
    "test:integration:postgres": "npm run build:api && node scripts/integration-postgres.mjs",
    "test:integration:effectiveness": "npm run build:api && node scripts/integration-effectiveness.mjs",
    "test:integration:score-loop": "npm run build:api && node scripts/integration-score-improvement-loop.mjs",
    "test:integration:review-shadow-cohort": "npm run build:api && node scripts/integration-review-shadow-cohort.mjs",
    "test:integration:review-mastery-cohort": "npm run build:api && node scripts/integration-review-mastery-cohort.mjs",
    "test:integration:review-mastery-production": "npm run build:api && node scripts/integration-review-mastery-production.mjs",
    "test:integration:event-key": "npm run build:api && node scripts/integration-event-key.mjs",
    "test:integration:import-first": "npm run build:api && node scripts/integration-import-first.mjs",
    "test:integration:content-import": "npm run build:api && node scripts/integration-content-import.mjs",
    "test:integration:question-import": "npm run build:api && node scripts/integration-question-import.mjs",
    "check:release": "npm test && npm run verify:api-build-layout && npm run build:web && npm run smoke:migration",
    "test:integration:exam-aligned": "npm run build:api && node scripts/integration-exam-aligned.mjs",
    "test:integration:score-anchor": "node scripts/integration-score-anchor.mjs",
    "test:integration:transfer-probe": "node scripts/integration-transfer-probe.mjs"
  }
}
