{
  "name": "kaoyan-408-score-boost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "verify:ui": "node scripts/verify-ui.mjs",
    "check:local": "node --test && node scripts/verify-ui.mjs",
    "predeploy": "node --test",
    "build:shared": "npm run build -w packages/shared",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build:web": "npm run build:shared && npm run build -w apps/web",
    "build:api": "npm run build:shared && npm run build -w apps/api"
  }
}
