          "criteria": { "A": "针对具体能力缺陷设计训练", "B": "有部分", "C": "普通刷题", "D": "无" } },
        { "id": "T3", "name": "分层训练", "priority": "P0", "evidenceRequired": "training ladder",
          "criteria": { "A": "基础→变式→综合→真题有明确 progression", "B": "有难度分层", "C": "只有题库难度", "D": "无" } },
        { "id": "T4", "name": "即时纠错", "priority": "P0", "evidenceRequired": "feedback loop",
          "criteria": { "A": "错误后针对性反馈并再次验证", "B": "有解析", "C": "只有答案", "D": "无" } },
        { "id": "T5", "name": "错题再练", "priority": "P0", "evidenceRequired": "variant generation",
          "criteria": { "A": "再练针对错误机制变式，非简单重复", "B": "有重复", "C": "原题重复", "D": "无" } },
        { "id": "T6", "name": "变式训练", "priority": "P0", "evidenceRequired": "variant set",
