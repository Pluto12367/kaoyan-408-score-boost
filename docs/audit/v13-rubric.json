{
  "version": "13.0.0",
  "createdAt": "2026-09-14",
  "source": "Owner V13 审计框架（原则：功能存在 ≠ 能力成立；A=已能被证据证明产生提分价值）",
  "note": "本文件是 V13 提分能力审计的唯一评分口径（rubric 即数据）。判定标准为 Owner 框架原文的压缩版。评级证据见 v13-evidence.json，报告由 scripts/audit-v13-scorecard.mjs 生成。",
  "scoring": {
    "gradeAnchors": { "A": 1.0, "B": 0.6, "C": 0.25, "D": 0 },
    "gradeSemantics": {
      "A": "已经能够被证据证明产生提分价值",
      "B": "底层能力存在，但闭环/证据不足",
      "C": "有功能或数据，但对提分作用弱/不可验证",
      "D": "缺失"
    },
    "itemWeighting": "equal（层内各项等权；priority 只用于路线排序与 P0 门禁，不参与加权）",
    "layerLetterRule": "层分 = 层内各项 anchor 分均值；层等级 = 距 anchor 最近者，等距时向下取（保守）",
    "closedLoopRule": {
      "loopLayers": ["diagnosis", "decision", "training", "validation"],
      "layerGate": "四个闭环层（诊断/决策/训练/验证）每层等级 ≥ B",
      "p0Gate": "四个闭环层内任意 P0 审计项 < B，即闭环不完整",
      "verdict": "两条门禁同时满足才可宣称『具备完整提分闭环』；否则 FAIL。平均分会掩盖短板，闭环判定优先于总分。"
    },
    "honestyRules": [
      "评级对象是『系统的提分能力主张』，不是学生分数增益；任何评级不得被引用为 Verified Score Gain（AGENTS.md RULE-11）。",
      "每个评级必须引用代码级证据（file:line 或测试/集成脚本）；证据不足按低档评，不因『应该有』而抬档。",
      "『代码存在但生产样本=0/开关 OFF』按 B 上限评（底层能力存在，证据不足），并在 gap 中显式记录。"
    ]
  },
  "layers": [
    {
      "id": "data",
      "name": "L1 数据 Data",
      "weight": 0.15,
      "question": "系统有没有记录『影响得分』的信息？数据是否足以解释失分",
      "items": [
        { "id": "D1", "name": "作答事件", "priority": "P0", "evidenceRequired": "AnswerReceipt + replay",
          "criteria": { "A": "每次作答均形成不可变回执，可完整重放", "B": "大部分作答可追踪", "C": "仅保存结果", "D": "无统一作答记录" } },
        { "id": "D2", "name": "正误数据", "priority": "P0", "evidenceRequired": "作答日志",
          "criteria": { "A": "正误 + 时间 + 尝试次数 + 是否修改答案", "B": "有正误和部分行为数据", "C": "只有正误", "D": "无稳定记录" } },
        { "id": "D3", "name": "知识点映射", "priority": "P0", "evidenceRequired": "Question → KnowledgeNode",
          "criteria": { "A": "每题映射明确知识点且支持多知识点", "B": "基本映射", "C": "粗粒度 subject/tag", "D": "无映射" } },
        { "id": "D4", "name": "题型数据", "priority": "P0", "evidenceRequired": "question metadata",
          "criteria": { "A": "能区分选择/算法/计算/大题子类型等", "B": "有部分题型", "C": "只有题目类型", "D": "无题型" } },
        { "id": "D5", "name": "错因数据", "priority": "P0", "evidenceRequired": "error taxonomy",
          "criteria": { "A": "能记录知识不会/概念混淆/计算错误/方法错误/审题/粗心/迁移失败等", "B": "有人工 self-check", "C": "只有 wrong", "D": "无错因" } },
        { "id": "D6", "name": "难度数据", "priority": "P1", "evidenceRequired": "difficulty calibration",
          "criteria": { "A": "难度可靠标定并持续校准", "B": "有静态难度", "C": "只有简单/中等/困难", "D": "无难度" } },
        { "id": "D7", "name": "时间行为", "priority": "P1", "evidenceRequired": "timing events",
          "criteria": { "A": "答题耗时、超时、犹豫、修改均有记录", "B": "记录耗时", "C": "仅记录提交时间", "D": "无" } },
        { "id": "D8", "name": "大题得分", "priority": "P0", "evidenceRequired": "subjective scoring",
          "criteria": { "A": "总分 + 分项得分 + 丢分位置", "B": "有 selfScore", "C": "只有总分", "D": "无" } },
        { "id": "D9", "name": "Review 数据", "priority": "P0", "evidenceRequired": "review events",
          "criteria": { "A": "每次复习产生独立事件，而非『已复习』", "B": "有 review event", "C": "只有次数", "D": "无" } },
        { "id": "D10", "name": "模考数据", "priority": "P0", "evidenceRequired": "assessment snapshot",
          "criteria": { "A": "完整考试级数据", "B": "保存总成绩", "C": "只有单题成绩", "D": "无" } },
        { "id": "D11", "name": "状态历史", "priority": "P0", "evidenceRequired": "snapshots/version",
          "criteria": { "A": "StudentState/Mastery 版本化历史，可比较前后变化", "B": "有 snapshot", "C": "只有当前值", "D": "无历史" } },
        { "id": "D12", "name": "干预记录", "priority": "P0", "evidenceRequired": "intervention log",
          "criteria": { "A": "知道系统何时对学生进行了什么干预（完整 log）", "B": "部分记录", "C": "无", "D": "无" } }
      ]
    },
    {
      "id": "diagnosis",
      "name": "L2 诊断 Diagnosis",
      "weight": 0.25,
      "question": "系统知道学生为什么丢分吗？能否定位到知识/题型/能力/错因",
      "items": [
        { "id": "G1", "name": "知识掌握诊断", "priority": "P0", "evidenceRequired": "mastery history",
          "criteria": { "A": "节点 mastery 随证据动态变化", "B": "有 mastery 模型但验证不足", "C": "静态正确率", "D": "无" } },
        { "id": "G2", "name": "遗忘诊断", "priority": "P0", "evidenceRequired": "recall prediction",
          "criteria": { "A": "识别『曾经会→现在可能不会』", "B": "有 FSRS/shadow", "C": "仅看最近错误", "D": "无" } },
        { "id": "G3", "name": "错因诊断", "priority": "P0", "evidenceRequired": "error labels",
          "criteria": { "A": "区分 5~8 类稳定失分原因", "B": "有部分分类", "C": "只有错题", "D": "无" } },
        { "id": "G4", "name": "题型能力诊断", "priority": "P0", "evidenceRequired": "type-level mastery",
          "criteria": { "A": "判断『会知识点但不会该题型』", "B": "有粗粒度题型统计", "C": "只有知识点", "D": "无" } },
        { "id": "G5", "name": "迁移能力诊断", "priority": "P0", "evidenceRequired": "difficulty transfer matrix",
          "criteria": { "A": "识别基础题→变式→真题的能力断层", "B": "有部分难度分层", "C": "只统计整体正确率", "D": "无" } },
        { "id": "G6", "name": "大题能力诊断", "priority": "P0", "evidenceRequired": "rubric/subscore",
          "criteria": { "A": "定位算法设计/计算/证明/步骤等具体丢分点", "B": "有 selfScore", "C": "只有总分", "D": "无" } },
        { "id": "G7", "name": "低级错误诊断", "priority": "P1", "evidenceRequired": "mistake taxonomy",
          "criteria": { "A": "识别粗心、符号、计算、审题等非知识性失分", "B": "有人工标记", "C": "混在 wrong 中", "D": "无" } },
        { "id": "G8", "name": "前置知识诊断", "priority": "P1", "evidenceRequired": "prerequisite chain",
          "criteria": { "A": "追踪 prerequisite failure", "B": "有知识图谱但未用于诊断", "C": "只有节点关系", "D": "无" } },
        { "id": "G9", "name": "跨题模式诊断", "priority": "P0", "evidenceRequired": "error pattern aggregation",
          "criteria": { "A": "发现重复错误模式（同型错误 N 次→技能缺口）", "B": "可人工查看", "C": "单题分析", "D": "无" } },
        { "id": "G10", "name": "置信度", "priority": "P1", "evidenceRequired": "diagnosis confidence",
          "criteria": { "A": "每个诊断有 confidence 且知道何时不确定", "B": "有简单 confidence", "C": "无置信度", "D": "无" } },
        { "id": "G11", "name": "诊断准确性", "priority": "P0", "evidenceRequired": "labeled benchmark",
          "criteria": { "A": "与专家/真实结果达到预设准确率", "B": "有离线测试", "C": "未验证", "D": "无" } }
      ]
    },
    {
      "id": "decision",
      "name": "L3 决策 Decision",
      "weight": 0.25,
      "question": "系统知道下一步最应该练什么吗？推荐是否因人而异且可解释",
      "items": [
        { "id": "R1", "name": "下一任务选择", "priority": "P0", "evidenceRequired": "recommendation trace",
          "criteria": { "A": "学生状态+目标+遗忘+题型+错因共同决定", "B": "有多因素推荐", "C": "基于 mastery/错题", "D": "随机/固定" } },
        { "id": "R2", "name": "优先级计算", "priority": "P0", "evidenceRequired": "decision trace",
          "criteria": { "A": "能回答『为什么现在必须练这个』", "B": "有 reason code", "C": "有排序无解释", "D": "无排序" } },
        { "id": "R3", "name": "个体化", "priority": "P0", "evidenceRequired": "A/B student test",
          "criteria": { "A": "两个不同学生得到不同训练路径（有验证）", "B": "部分个性化", "C": "大部分相同", "D": "完全固定" } },
        { "id": "R4", "name": "训练策略选择", "priority": "P0", "evidenceRequired": "policy trace",
          "criteria": { "A": "能选择学习/回忆/变式/真题/限时等策略", "B": "有策略但规则固定", "C": "只有题目推荐", "D": "无策略" } },
        { "id": "R5", "name": "难度调节", "priority": "P0", "evidenceRequired": "difficulty transitions",
          "criteria": { "A": "根据表现动态升降难度", "B": "有基础难度调整", "C": "固定难度", "D": "无" } },
        { "id": "R6", "name": "间隔策略", "priority": "P0", "evidenceRequired": "review schedule",
          "criteria": { "A": "根据 recall risk 调整复习时间", "B": "FSRS shadow", "C": "固定间隔", "D": "无" } },
        { "id": "R7", "name": "前置知识决策", "priority": "P1", "evidenceRequired": "prerequisite intervention",
          "criteria": { "A": "前置节点失败时自动改变训练路径", "B": "能提示 prerequisite", "C": "只展示关系", "D": "无" } },
        { "id": "R8", "name": "大题策略", "priority": "P0", "evidenceRequired": "rubric → task",
          "criteria": { "A": "根据丢分维度选择对应训练", "B": "有大题推荐", "C": "普通题推荐", "D": "无" } },
        { "id": "R9", "name": "推荐反馈", "priority": "P0", "evidenceRequired": "recommendation outcome",
          "criteria": { "A": "完成任务后判断『推荐是否有效』且回流", "B": "有简单反馈", "C": "只有完成状态", "D": "无" } },
        { "id": "R10", "name": "策略自适应", "priority": "P0", "evidenceRequired": "policy transition",
          "criteria": { "A": "推荐失败后自动改变策略", "B": "有人工调整", "C": "固定规则", "D": "无" } },
        { "id": "R11", "name": "目标约束", "priority": "P1", "evidenceRequired": "target-aware policy",
          "criteria": { "A": "根据考试日期/目标分数调整资源分配", "B": "有计划", "C": "只有日计划", "D": "无" } },
        { "id": "R12", "name": "时间预算", "priority": "P1", "evidenceRequired": "budget simulation",
          "criteria": { "A": "30/60/120 分钟不同预算生成不同最优路径", "B": "有时间参数", "C": "固定任务量", "D": "无" } }
      ]
    },
    {
      "id": "training",
      "name": "L4 训练 Training",
      "weight": 0.25,
      "question": "推荐之后真的能让学生变强吗？是否形成刻意训练闭环",
      "items": [
        { "id": "T1", "name": "诊断→训练闭环", "priority": "P0", "evidenceRequired": "diagnosis→task trace",
          "criteria": { "A": "每个关键诊断都有针对性训练", "B": "大部分有", "C": "推荐泛化", "D": "无" } },
