        { "id": "T11", "name": "迁移训练", "priority": "P0", "evidenceRequired": "transfer test",
          "criteria": { "A": "训练后必须进入新题验证", "B": "有部分", "C": "只重复同类题", "D": "无" } },
        { "id": "T12", "name": "训练闭环", "priority": "P0", "evidenceRequired": "end-to-end trace",
          "criteria": { "A": "训练→测试→状态更新→下一策略完整闭环", "B": "部分闭环", "C": "只有训练记录", "D": "无" } }
      ]
    },
    {
      "id": "validation",
      "name": "L5 验证 Validation",
      "weight": 0.1,
      "question": "怎么证明学生真的提高了？是否有学习增益/真题/模考证据",
      "items": [
        { "id": "V1", "name": "前后测", "priority": "P0", "evidenceRequired": "pre/post test",
