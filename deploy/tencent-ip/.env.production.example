# Use a random password containing only URL-safe characters so DATABASE_URL remains valid.
PUBLIC_IP=replace-with-server-public-ip
POSTGRES_USER=kaoyan408
POSTGRES_PASSWORD=generate-a-base64url-password
POSTGRES_DB=kaoyan408
JWT_SECRET=generate-a-random-secret-with-at-least-32-characters
BACKUP_RETENTION_DAYS=14
QUESTION_IMPORT_MAX_PDF_BYTES=524288000
QUESTION_IMPORT_MAX_PROVIDER_PAGES=200
QUESTION_IMPORT_TEMPORARY_QUOTA_BYTES=10737418240
QUESTION_IMPORT_DISK_STOP_PERCENT=80
MINERU_API_TOKEN=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-shanghai
QUESTION_IMPORT_DATA_DIR=/var/lib/kaoyan408/question-imports
# HTTP IP pilot defaults. Keep this only for a small closed trial.
WEB_ORIGIN=http://replace-with-server-public-ip
ALLOW_INSECURE_HTTP_IP=true

# Formal HTTPS settings. Before switching, issue the certificate, open TCP 443,
# and run Compose with compose.production.yml plus compose.https.yml.
# WEB_ORIGIN=https://exam.example.com
# VITE_API_BASE_URL=https://exam.example.com/api
# TLS_CERT_DIR=/etc/letsencrypt/live/exam.example.com
# ALLOW_INSECURE_HTTP_IP=false
# Optional DeepSeek AI tutor (stage 7). Leave AI_API_KEY empty to keep the
# template-based tutor reply; real model calls require a DeepSeek API key.
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_BASE_URL=https://api.deepseek.com
AI_TIMEOUT_MS=25000
AI_MAX_TOKENS=2000
