# TLS-ready nginx config for 408 score boost.
#
# To activate HTTPS:
#   1. Point a domain (e.g. kaoyan.example.com) A record at this server IP.
#   2. Run certbot to issue a certificate (see docs/deploy-to-tencent-ip.md).
#   3. Replace deploy/tencent-ip/nginx.conf with this file, set the domain and
#      certificate paths, then re-run ./deploy/tencent-ip/deploy.sh.

server {
  listen 80;
  server_name kaoyan.example.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name kaoyan.example.com;

  ssl_certificate     /etc/letsencrypt/live/kaoyan.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/kaoyan.example.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;

  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 500m;
  client_body_timeout 120s;
  proxy_read_timeout 120s;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location /api/ {
    proxy_pass http://app:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  location = /health {
    proxy_pass http://app:3000/health;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
