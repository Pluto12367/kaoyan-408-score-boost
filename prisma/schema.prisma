generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum TrialStatus {
  INVITED
  ACTIVE
  COMPLETED
  FOLLOW_UP
}

enum Subject {
  DATA_STRUCTURE
  COMPUTER_ORGANIZATION
  OPERATING_SYSTEM
  COMPUTER_NETWORK
}

enum Difficulty {
  BASIC
  MEDIUM
  HARD
}

enum QuestionType {
  SINGLE_CHOICE
  COMPREHENSIVE
  JUDGEMENT
}

enum QuestionImportFileType {
  pdf
  xlsx
  csv
}

enum QuestionImportBatchStatus {
  uploaded
  queued
  parsing
  parsing_partial_failure
  review
  partially_imported
  completed
  failed
  cancelled
  expired
}

enum QuestionImportCandidateStatus {
  pending_review
  needs_edit
  duplicate_suspected
  approved
  ignored
  parse_failed
  imported
}

enum QuestionImportJobState {
  pending
  queued
  running
  succeeded
  failed
  cancelled
}

enum QuestionImportDuplicateAction {
  skip
  create
  new_version
}

enum QuestionImportAssetScope {
  temporary
  permanent
}

model User {
  id                    String                        @id @default(cuid())
  email                 String?                       @unique
  passwordHash          String?
  name                  String
  role                  UserRole
  accountStatus         AccountStatus                 @default(ACTIVE)
  mustChangePassword    Boolean                       @default(false)
  trialStatus           TrialStatus                   @default(INVITED)
  targetSchool          String?
  targetScore           Int?
  currentScore          Int?
  dailyHours            Float?
  remainingDays         Int?
  studyStage            String?
  weakestSubject        String?
  diagnosis             String?
  examYear              Int?
  onboardingCompletedAt DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  practiceRecords       PracticeRecord[]
  studyPlans            StudyPlan[]
  wrongQuestionReviews  WrongQuestionReview[]
  taskCompletions       StudyTaskCompletion[]
  refreshTokens         RefreshToken[]
  learningSessions      LearningSession[]
  reviewSchedules       ReviewSchedule[]
  examReviewPlans       ExamReviewPlan[]
  operationLogs         OperationLog[]
  feedbackSubmissions   FeedbackSubmission[]
  authorizedStudents    TeacherStudentAuthorization[] @relation("AuthorizedTeacher")
  authorizedTeachers    TeacherStudentAuthorization[] @relation("AuthorizedStudent")
  createdInvitations    InvitationCode[]              @relation("CreatedInvitations")
  invitationRedemptions InvitationRedemption[]
  uploadedImportBatches QuestionImportBatch[]      @relation("QuestionImportUploader")
}

model FeedbackSubmission {
  id        String   @id @default(cuid())
  userId    String
  rating    Int
  scene     String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model TeacherStudentAuthorization {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  createdAt DateTime @default(now())
  teacher   User     @relation("AuthorizedTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student   User     @relation("AuthorizedStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@index([studentId])
}

model OperationLog {
  id         String   @id @default(cuid())
  requestId  String
  userId     String?
  role       String?
  method     String
  path       String
  statusCode Int
  durationMs Int
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([method, path, createdAt])
  @@index([statusCode, createdAt])
}

model InvitationCode {
  id          String                 @id @default(cuid())
  codeHash    String                 @unique
  codePrefix  String
  label       String
  maxUses     Int
  usedCount   Int                    @default(0)
  startsAt    DateTime               @default(now())
  expiresAt   DateTime
  disabledAt  DateTime?
  createdById String
  createdAt   DateTime               @default(now())
  createdBy   User                   @relation("CreatedInvitations", fields: [createdById], references: [id])
  redemptions InvitationRedemption[]

  @@index([expiresAt, disabledAt])
}

model InvitationRedemption {
  id               String         @id @default(cuid())
  invitationCodeId String
  userId           String
  redeemedAt       DateTime       @default(now())
  invitationCode   InvitationCode @relation(fields: [invitationCodeId], references: [id], onDelete: Restrict)
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([invitationCodeId, userId])
  @@index([userId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  result     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model LearningSession {
  id              String           @id
  userId          String
  type            String
  resourceId      String?
  questionIds     String[]
  questionSnapshot Json             @default("[]")
  answers         Json
  markedQuestions String[]
  currentIndex    Int              @default(0)
  revision        Int              @default(0)
  startedAt       DateTime         @default(now())
  lastActiveAt    DateTime         @default(now())
  totalActiveMs   Int              @default(0)
  lastResumeAt    DateTime         @default(now())
  completed       Boolean          @default(false)
  submittedAt     DateTime?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceRecords PracticeRecord[]
  examReviewPlan  ExamReviewPlan?

  @@index([userId, completed, lastActiveAt])
  @@index([userId, type, resourceId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model KnowledgePoint {
  id            String                   @id
  subject       Subject
  chapter       String
  title         String
  importance    Int
  frequency     Int
  prerequisites String[]
  questions     QuestionKnowledgePoint[]
  records       PracticeRecord[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model Question {
  id                   String                   @id @default(cuid())
  familyId             String
  versionNumber        Int                      @default(1)
  isCurrent            Boolean                  @default(true)
  contentFingerprint   String
  importBatchId        String?
  stem                 String
  options              String[]
  answer               String
  analysis             String
  difficulty           Difficulty
  type                 QuestionType
  source               String
  year                 Int?
  expectedTimeSec      Int                      @default(100)
  knowledgePoints      QuestionKnowledgePoint[]
  records              PracticeRecord[]
  wrongQuestionReviews WrongQuestionReview[]
  reviewSchedules      ReviewSchedule[]
  family               QuestionFamily           @relation(fields: [familyId], references: [id], onDelete: Restrict)
  importBatch          QuestionImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  importCandidates     QuestionImportCandidate[] @relation("ImportedQuestionCandidate")
  importAssets         QuestionImportAsset[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([familyId, versionNumber])
  @@index([isCurrent, createdAt])
  @@index([contentFingerprint, isCurrent])
}

model QuestionFamily {
  id               String                   @id @default(cuid())
  versions         Question[]
  targetCandidates QuestionImportCandidate[]
  createdAt        DateTime                 @default(now())
}

model QuestionImportBatch {
  id                  String                       @id @default(cuid())
  uploadedById        String
  uploadedBy          User                         @relation("QuestionImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  originalFileName    String
  originalStorageKey  String
  fileSha256          String
  fileType            QuestionImportFileType
  source              String
  title               String?
  year                Int?
  defaultSubject      String?
  defaultChapter      String?
  pageRange           String?
  rightsConfirmed     Boolean
  rightsConfirmedAt   DateTime?
  status              QuestionImportBatchStatus    @default(uploaded)
  statusCounts        Json                         @default("{}")
  providerSummary     Json?
  costSummary         Json?
  expiresAt           DateTime
  completedAt         DateTime?
  failedAt            DateTime?
  revision            Int                          @default(0)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  jobs                QuestionImportJob[]
  candidates          QuestionImportCandidate[]
  assets              QuestionImportAsset[]
  confirmations       QuestionImportConfirmation[]
  questions           Question[]

  @@index([uploadedById, createdAt])
  @@index([fileSha256, status])
  @@index([status, expiresAt])
}

model QuestionImportJob {
  id             String                 @id @default(cuid())
  batchId        String
  pageStart      Int
  pageEnd        Int
  provider       String
  externalTaskId String?
  providerInputStorageKey String?
  attempt        Int                    @default(0)
  retryAt        DateTime?
  leaseOwner     String?
  leaseExpiresAt DateTime?
  state          QuestionImportJobState @default(pending)
  quality        Json?
  cost           Json?
  error          Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  batch          QuestionImportBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  candidates     QuestionImportCandidate[]

  @@index([batchId, state, retryAt])
  @@index([state, retryAt, leaseExpiresAt, createdAt])
  @@index([externalTaskId])
}

model QuestionImportCandidate {
  id                String                        @id @default(cuid())
  batchId           String
  jobId             String?
  sourceRowNumber   Int?
  stem              String
  options           String[]
  answer            String
  analysis          String
  difficulty        Difficulty
  type              QuestionType
  source            String
  year              Int?
  expectedTimeSec   Int                           @default(100)
  knowledgePointIds String[]
  formulas          Json                          @default("[]")
  warnings          Json                          @default("[]")
  pageNumber        Int?
  sourceRegion      Json?
  contentFingerprint String
  targetFamilyId    String?
  status            QuestionImportCandidateStatus @default(pending_review)
  duplicateAction   QuestionImportDuplicateAction @default(skip)
  reviewMetadata    Json?
  reviewedById      String?
  reviewedAt        DateTime?
  revision          Int                           @default(0)
  importedQuestionId String?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  batch             QuestionImportBatch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  job               QuestionImportJob?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  targetFamily      QuestionFamily?                @relation(fields: [targetFamilyId], references: [id], onDelete: Restrict)
  importedQuestion  Question?                      @relation("ImportedQuestionCandidate", fields: [importedQuestionId], references: [id], onDelete: Restrict)
  assets            QuestionImportAsset[]

  @@index([batchId, status, createdAt])
  @@index([contentFingerprint, status])
  @@index([targetFamilyId])
  @@index([jobId])
  @@unique([jobId, sourceRowNumber])
}

model QuestionImportAsset {
  id           String                   @id @default(cuid())
  batchId      String
  scope        QuestionImportAssetScope @default(temporary)
  storageKey   String                   @unique
  sha256       String
  mediaType    String
  byteSize     Int
  pageNumber   Int?
  sourceRegion Json?
  /// Temporary assets may have no candidate yet; permanent assets must be promoted to questionId by SQL constraint.
  candidateId  String?
  questionId   String?
  expiresAt    DateTime?
  promotedAt   DateTime?
  createdAt    DateTime                 @default(now())
  batch        QuestionImportBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  candidate    QuestionImportCandidate? @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  question     Question?                @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([batchId, scope, expiresAt])
  @@index([candidateId])
  @@index([questionId])
  @@index([sha256])
}

model QuestionImportConfirmation {
  id             String              @id @default(cuid())
  batchId        String
  idempotencyKey String              @unique
  actorId        String
  result         Json
  createdAt      DateTime            @default(now())
  batch          QuestionImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId, createdAt])
}

model QuestionKnowledgePoint {
  questionId       String
  knowledgePointId String
  question         Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@id([questionId, knowledgePointId])
}

model PracticeRecord {
  id               String           @id @default(cuid())
  userId           String
  questionId       String
  knowledgePointId String
  selectedAnswer   String?
  correct          Boolean
  timeSpentSec     Int
  expectedTimeSec  Int
  mistakeReason    String?
  submittedAt      DateTime         @default(now())
  sessionId        String?
  gradingMode      String           @default("objective")
  selfScore        Int?
  maxScore         Int?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  knowledgePoint   KnowledgePoint   @relation(fields: [knowledgePointId], references: [id])
  session          LearningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, submittedAt])
  @@index([knowledgePointId, correct])
  @@index([sessionId, submittedAt])
}

model WrongQuestionReview {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  reviewedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, reviewedAt])
}

model StudyTaskCompletion {
  id                     String   @id @default(cuid())
  userId                 String
  taskId                 String
  completedDate          String
  completedQuestionCount Int?
  correctCount           Int?
  minutesSpent           Int?
  selfRating             Int?
  completedAt            DateTime @default(now())
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, completedDate])
  @@index([userId, completedAt])
}

model StudyPlan {
  id            String      @id @default(cuid())
  userId        String
  phase         String
  targetScore   Int
  remainingDays Int
  dailyHours    Float
  checkpoint    String
  status        String      @default("ACTIVE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         StudyTask[]
}

model StudyTask {
  id               String    @id @default(cuid())
  planId           String
  knowledgePointId String
  subject          String    @default("")
  chapter          String    @default("")
  title            String
  mode             String
  minutes          Int
  questionCount    Int
  scheduledDate    String    @default("")
  priority         String    @default("低")
  reason           String    @default("")
  nextAction       String    @default("")
  status           String    @default("pending")
  postponeCount    Int       @default(0)
  startedAt        DateTime?
  nextAvailableAt  DateTime?
  completedAt      DateTime?
  completed        Boolean   @default(false)
  plan             StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, scheduledDate, status])
}

model AiTutorLog {
  id         String   @id @default(cuid())
  userId     String
  questionId String?
  prompt     String
  response   String
  reviewed   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model RuntimeState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ReviewSchedule {
  id                 String          @id @default(cuid())
  userId             String
  questionId         String
  inferredReason     String?
  selfReportedReason String?
  note               String?
  lastWrongRecordId  String?
  redoCorrect        Boolean         @default(false)
  timeSpentSec       Int             @default(0)
  consecutiveCorrect Int             @default(0)
  stability          String          @default("learning")
  nextReviewAt       DateTime
  reviewCount        Int             @default(0)
  lastReviewedAt     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question           Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempts           ReviewAttempt[]

  @@unique([userId, questionId])
  @@index([userId, stability, nextReviewAt])
}

model ReviewAttempt {
  id               String         @id @default(cuid())
  scheduleId       String
  redoCorrect      Boolean
  timeSpentSec     Int
  reportedReason   String?
  inferredReason   String?
  nextIntervalDays Int
  reviewedAt       DateTime       @default(now())
  schedule         ReviewSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, reviewedAt])
}

model ExamReviewPlan {
  id               String          @id @default(cuid())
  sessionId        String          @unique
  userId           String
  days             Json
  recommendation   String
  examAccuracyRate Int
  weakPointTitles  String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  session          LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
