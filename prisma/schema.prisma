generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum TrialStatus {
  INVITED
  ACTIVE
  COMPLETED
  FOLLOW_UP
}

enum Subject {
  DATA_STRUCTURE
  COMPUTER_ORGANIZATION
  OPERATING_SYSTEM
  COMPUTER_NETWORK
}

enum Difficulty {
  BASIC
  MEDIUM
  HARD
}

enum QuestionType {
  SINGLE_CHOICE
  COMPREHENSIVE
  JUDGEMENT
}

enum QuestionImportFileType {
  pdf
  xlsx
  csv
}

enum QuestionImportBatchStatus {
  uploaded
  queued
  parsing
  parsing_partial_failure
  review
  partially_imported
  completed
  failed
  cancelled
  expired
}

enum QuestionImportCandidateStatus {
  pending_review
  needs_edit
  duplicate_suspected
  approved
  ignored
  parse_failed
  imported
}

enum QuestionImportJobState {
  pending
  queued
  running
  succeeded
  failed
  cancelled
}

enum QuestionImportDuplicateAction {
  skip
  create
  new_version
}

enum QuestionImportAssetScope {
  temporary
  permanent
}

enum KnowledgeRelationType {
  PREREQUISITE
  RELATED
  CROSS_SUBJECT
  CONFUSED_WITH
  SUPERSEDES
}

enum ExamTagRole {
  PRIMARY
  SECONDARY
}

enum ExamTagPrecision {
  EXACT_ATOMIC
  BROAD_HISTORICAL
}

enum ExamTagger {
  AI
  HUMAN
  HYBRID
}

enum TrendDirection {
  RISING
  STABLE
  FALLING
  COLD
}

enum EvidenceConfidence {
  HIGH
  MEDIUM
  LOW
}

enum AnswerReceiptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id                     String                        @id @default(cuid())
  email                  String?                       @unique
  passwordHash           String?
  name                   String
  role                   UserRole
  accountStatus          AccountStatus                 @default(ACTIVE)
  mustChangePassword     Boolean                       @default(false)
  trialStatus            TrialStatus                   @default(INVITED)
  targetSchool           String?
  targetScore            Int?
  currentScore           Int?
  dailyHours             Float?
  remainingDays          Int?
  studyStage             String?
  weakestSubject         String?
  diagnosis              String?
  examYear               Int?
  onboardingCompletedAt  DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  practiceRecords        PracticeRecord[]
  studyPlans             StudyPlan[]
  wrongQuestionReviews   WrongQuestionReview[]
  taskCompletions        StudyTaskCompletion[]
  refreshTokens          RefreshToken[]
  learningSessions       LearningSession[]
  reviewSchedules        ReviewSchedule[]
  examReviewPlans        ExamReviewPlan[]
  operationLogs          OperationLog[]
  feedbackSubmissions    FeedbackSubmission[]
  authorizedStudents     TeacherStudentAuthorization[] @relation("AuthorizedTeacher")
  authorizedTeachers     TeacherStudentAuthorization[] @relation("AuthorizedStudent")
  createdInvitations     InvitationCode[]              @relation("CreatedInvitations")
  invitationRedemptions  InvitationRedemption[]
  uploadedImportBatches  QuestionImportBatch[]         @relation("QuestionImportUploader")
  assessmentHistoryItems AssessmentHistoryItem[]
  userEvents             UserEvent[]
  knowledgeMasteries     UserKnowledgeMastery[]
  masterySnapshots       UserMasterySnapshot[]
  nodeQuests             UserNodeQuest[]
  answerReceipts         AnswerReceipt[]
  studyTaskProgresses    StudyTaskProgress[]
}

model AnswerReceipt {
  id                String              @id @default(cuid())
  userId            String
  idempotencyKey    String
  requestHash       String
  hashVersion       String              @default("v1")
  status            AnswerReceiptStatus @default(PENDING)
  responseSnapshot  Json?
  practiceRecordIds String[]            @default([])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([status, updatedAt])
}

model UserEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

model FeedbackSubmission {
  id        String   @id @default(cuid())
  userId    String
  rating    Int
  scene     String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model TeacherStudentAuthorization {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  createdAt DateTime @default(now())
  teacher   User     @relation("AuthorizedTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student   User     @relation("AuthorizedStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@index([studentId])
}

model OperationLog {
  id         String   @id @default(cuid())
  requestId  String
  userId     String?
  role       String?
  method     String
  path       String
  statusCode Int
  durationMs Int
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([method, path, createdAt])
  @@index([statusCode, createdAt])
}

model InvitationCode {
  id          String                 @id @default(cuid())
  codeHash    String                 @unique
  codePrefix  String
  label       String
  maxUses     Int
  usedCount   Int                    @default(0)
  startsAt    DateTime               @default(now())
  expiresAt   DateTime
  disabledAt  DateTime?
  createdById String
  createdAt   DateTime               @default(now())
  createdBy   User                   @relation("CreatedInvitations", fields: [createdById], references: [id])
  redemptions InvitationRedemption[]

  @@index([expiresAt, disabledAt])
}

model InvitationRedemption {
  id               String         @id @default(cuid())
  invitationCodeId String
  userId           String
  redeemedAt       DateTime       @default(now())
  invitationCode   InvitationCode @relation(fields: [invitationCodeId], references: [id], onDelete: Restrict)
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([invitationCodeId, userId])
  @@index([userId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  result     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model LearningSession {
  id               String           @id
  userId           String
  type             String
  resourceId       String?
  questionIds      String[]
  questionSnapshot Json             @default("[]")
  answers          Json
  markedQuestions  String[]
  currentIndex     Int              @default(0)
  revision         Int              @default(0)
  startedAt        DateTime         @default(now())
  lastActiveAt     DateTime         @default(now())
  totalActiveMs    Int              @default(0)
  lastResumeAt     DateTime         @default(now())
  completed        Boolean          @default(false)
  submittedAt      DateTime?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceRecords  PracticeRecord[]
  examReviewPlan   ExamReviewPlan?

  @@index([userId, completed, lastActiveAt])
  @@index([userId, type, resourceId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model KnowledgePoint {
  id            String                   @id
  subject       Subject
  chapter       String
  title         String
  importance    Int
  frequency     Int
  prerequisites String[]
  questions     QuestionKnowledgePoint[]
  records       PracticeRecord[]
  nodeMaps      KnowledgePointNodeMap[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model Question {
  id                   String                     @id @default(cuid())
  familyId             String
  versionNumber        Int                        @default(1)
  isCurrent            Boolean                    @default(true)
  contentFingerprint   String
  importBatchId        String?
  stem                 String
  options              String[]
  answer               String
  analysis             String
  difficulty           Difficulty
  type                 QuestionType
  source               String
  year                 Int?
  expectedTimeSec      Int                        @default(100)
  formulas             Json                       @default("[]")
  sourceRegion         Json?
  knowledgePoints      QuestionKnowledgePoint[]
  records              PracticeRecord[]
  wrongQuestionReviews WrongQuestionReview[]
  reviewSchedules      ReviewSchedule[]
  knowledgeNodeTags    QuestionKnowledgeNodeTag[]
  family               QuestionFamily             @relation(fields: [familyId], references: [id], onDelete: Restrict)
  importBatch          QuestionImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  importCandidates     QuestionImportCandidate[]  @relation("ImportedQuestionCandidate")
  importAssets         QuestionImportAsset[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([familyId, versionNumber])
  @@index([isCurrent, createdAt])
  @@index([contentFingerprint, isCurrent])
}

model QuestionFamily {
  id               String                    @id @default(cuid())
  versions         Question[]
  targetCandidates QuestionImportCandidate[]
  createdAt        DateTime                  @default(now())
}

model QuestionImportBatch {
  id                 String                       @id @default(cuid())
  uploadedById       String
  uploadedBy         User                         @relation("QuestionImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  originalFileName   String
  originalStorageKey String
  fileSha256         String
  fileType           QuestionImportFileType
  source             String
  title              String?
  year               Int?
  defaultSubject     String?
  defaultChapter     String?
  pageRange          String?
  rightsConfirmed    Boolean
  rightsConfirmedAt  DateTime?
  status             QuestionImportBatchStatus    @default(uploaded)
  statusCounts       Json                         @default("{}")
  providerSummary    Json?
  costSummary        Json?
  expiresAt          DateTime
  completedAt        DateTime?
  failedAt           DateTime?
  revision           Int                          @default(0)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  jobs               QuestionImportJob[]
  candidates         QuestionImportCandidate[]
  assets             QuestionImportAsset[]
  confirmations      QuestionImportConfirmation[]
  questions          Question[]

  @@index([uploadedById, createdAt])
  @@index([fileSha256, status])
  @@index([status, expiresAt])
}

model QuestionImportJob {
  id                      String                    @id @default(cuid())
  batchId                 String
  pageStart               Int
  pageEnd                 Int
  provider                String
  externalTaskId          String?
  providerInputStorageKey String?
  attempt                 Int                       @default(0)
  retryAt                 DateTime?
  leaseOwner              String?
  leaseExpiresAt          DateTime?
  state                   QuestionImportJobState    @default(pending)
  quality                 Json?
  cost                    Json?
  error                   Json?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  batch                   QuestionImportBatch       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  candidates              QuestionImportCandidate[]

  @@index([batchId, state, retryAt])
  @@index([state, retryAt, leaseExpiresAt, createdAt])
  @@index([externalTaskId])
}

model QuestionImportCandidate {
  id                 String                        @id @default(cuid())
  batchId            String
  jobId              String?
  sourceRowNumber    Int?
  stem               String
  options            String[]
  answer             String
  analysis           String
  difficulty         Difficulty
  type               QuestionType
  source             String
  year               Int?
  expectedTimeSec    Int                           @default(100)
  knowledgePointIds  String[]
  formulas           Json                          @default("[]")
  warnings           Json                          @default("[]")
  pageNumber         Int?
  sourceRegion       Json?
  contentFingerprint String
  targetFamilyId     String?
  status             QuestionImportCandidateStatus @default(pending_review)
  duplicateAction    QuestionImportDuplicateAction @default(skip)
  reviewMetadata     Json?
  reviewedById       String?
  reviewedAt         DateTime?
  revision           Int                           @default(0)
  importedQuestionId String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  batch              QuestionImportBatch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  job                QuestionImportJob?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  targetFamily       QuestionFamily?               @relation(fields: [targetFamilyId], references: [id], onDelete: Restrict)
  importedQuestion   Question?                     @relation("ImportedQuestionCandidate", fields: [importedQuestionId], references: [id], onDelete: Restrict)
  assets             QuestionImportAsset[]

  @@unique([jobId, sourceRowNumber])
  @@index([batchId, status, createdAt])
  @@index([contentFingerprint, status])
  @@index([targetFamilyId])
  @@index([jobId])
}

model QuestionImportAsset {
  id           String                   @id @default(cuid())
  batchId      String
  scope        QuestionImportAssetScope @default(temporary)
  storageKey   String
  sha256       String
  mediaType    String
  byteSize     Int
  pageNumber   Int?
  sourceRegion Json?
  /// Temporary assets may have no candidate yet; permanent assets must be promoted to questionId by SQL constraint.
  candidateId  String?
  questionId   String?
  expiresAt    DateTime?
  promotedAt   DateTime?
  createdAt    DateTime                 @default(now())
  batch        QuestionImportBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  candidate    QuestionImportCandidate? @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  question     Question?                @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([batchId, scope, expiresAt])
  @@index([candidateId])
  @@index([questionId])
  @@index([sha256])
  @@index([storageKey])
}

model QuestionImportConfirmation {
  id             String              @id @default(cuid())
  batchId        String
  idempotencyKey String              @unique
  actorId        String
  result         Json
  createdAt      DateTime            @default(now())
  batch          QuestionImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId, createdAt])
}

model QuestionKnowledgePoint {
  questionId       String
  knowledgePointId String
  question         Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@id([questionId, knowledgePointId])
}

model PracticeRecord {
  id                String           @id @default(cuid())
  userId            String
  questionId        String
  knowledgePointId  String
  selectedAnswer    String?
  correct           Boolean
  timeSpentSec      Int
  expectedTimeSec   Int
  mistakeReason     String?
  submittedAt       DateTime         @default(now())
  sessionId         String?
  gradingMode       String           @default("objective")
  selfScore         Int?
  maxScore          Int?
  confidence        String?
  usedHint          Boolean          @default(false)
  answerModified    Boolean          @default(false)
  variantQuestionId String?
  knowledgePointIds String[]         @default([])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question          Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  knowledgePoint    KnowledgePoint   @relation(fields: [knowledgePointId], references: [id])
  session           LearningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, submittedAt])
  @@index([knowledgePointId, correct])
  @@index([sessionId, submittedAt])
}

model WrongQuestionReview {
  id         String    @id @default(cuid())
  userId     String
  questionId String
  reviewedAt DateTime  @default(now())
  resolved   Boolean?
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, reviewedAt])
}

model StudyTaskCompletion {
  id                     String   @id @default(cuid())
  userId                 String
  taskId                 String
  completedDate          String
  completedQuestionCount Int?
  correctCount           Int?
  minutesSpent           Int?
  selfRating             Int?
  completedAt            DateTime @default(now())
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, completedDate])
  @@index([userId, completedAt])
}

model StudyTaskProgress {
  id                     String   @id @default(cuid())
  userId                 String
  taskId                 String
  completedQuestionCount Int      @default(0)
  correctCount           Int      @default(0)
  minutesSpent           Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
}

model StudyPlan {
  id               String      @id @default(cuid())
  userId           String
  phase            String
  targetScore      Int
  remainingDays    Int
  dailyHours       Float
  checkpoint       String
  source           String?
  modelVersion     String?
  targetExamDate   DateTime?
  availableMinutes Int?
  stale            Boolean     @default(false)
  status           String      @default("ACTIVE")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks            StudyTask[]
}

model StudyTask {
  id                   String         @id @default(cuid())
  planId               String
  knowledgePointId     String
  knowledgeNodeId      String?
  priorityScore        Int?
  recommendationAction String?
  reasonCodes          Json?
  scoreBreakdown       Json?
  generatedRank        Int?
  subject              String         @default("")
  chapter              String         @default("")
  title                String
  mode                 String
  minutes              Int
  questionCount        Int
  scheduledDate        String         @default("")
  priority             String         @default("低")
  reason               String         @default("")
  nextAction           String         @default("")
  status               String         @default("pending")
  postponeCount        Int            @default(0)
  startedAt            DateTime?
  nextAvailableAt      DateTime?
  completedAt          DateTime?
  completed            Boolean        @default(false)
  plan                 StudyPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  knowledgeNode        KnowledgeNode? @relation(fields: [knowledgeNodeId], references: [id], onDelete: SetNull)

  @@index([planId, scheduledDate, status])
}

model AiTutorLog {
  id         String   @id @default(cuid())
  userId     String
  questionId String?
  prompt     String
  response   String
  reviewed   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model RuntimeState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ReviewSchedule {
  id                 String          @id @default(cuid())
  userId             String
  questionId         String
  inferredReason     String?
  selfReportedReason String?
  note               String?
  lastWrongRecordId  String?
  redoCorrect        Boolean         @default(false)
  timeSpentSec       Int             @default(0)
  consecutiveCorrect Int             @default(0)
  stability          String          @default("learning")
  nextReviewAt       DateTime
  reviewCount        Int             @default(0)
  lastReviewedAt     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question           Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempts           ReviewAttempt[]

  @@unique([userId, questionId])
  @@index([userId, stability, nextReviewAt])
}

model ReviewAttempt {
  id               String         @id @default(cuid())
  scheduleId       String
  redoCorrect      Boolean
  timeSpentSec     Int
  reportedReason   String?
  inferredReason   String?
  nextIntervalDays Int
  reviewedAt       DateTime       @default(now())
  schedule         ReviewSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, reviewedAt])
}

model ExamReviewPlan {
  id               String          @id @default(cuid())
  sessionId        String          @unique
  userId           String
  days             Json
  recommendation   String
  examAccuracyRate Int
  weakPointTitles  String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  session          LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AssessmentHistoryItem {
  id               String   @id
  sessionId        String?  @unique
  paperId          String?
  userId           String
  title            String
  submittedAt      DateTime
  score            Int
  totalScore       Int
  accuracyRate     Int
  elapsedSec       Int
  unansweredCount  Int
  weakPointTitle   String
  reviewSuggestion String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, submittedAt])
}

model Paper {
  id                String   @id
  title             String
  paperType         String
  questionCount     Int
  knowledgePointIds String[]
  questions         Json
  estimatedMinutes  Int
  createdBy         String
  createdAt         DateTime @default(now())

  @@index([createdBy, createdAt])
}

model SystemConfig {
  id             Int      @id @default(autoincrement())
  recommendation Json
  updatedBy      String
  updatedAt      DateTime @updatedAt @default(now())
}

// ---- 408 score center: global knowledge evidence layer ----

model KnowledgeNode {
  id              String   @id
  parentId        String?
  subject         String
  nodeType        String
  name            String
  importance      Int
  difficulty      Int
  syllabusVersion String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent             KnowledgeNode?               @relation("KnowledgeTree", fields: [parentId], references: [id])
  children           KnowledgeNode[]              @relation("KnowledgeTree")
  outgoing           KnowledgeRelation[]          @relation("RelationFrom")
  incoming           KnowledgeRelation[]          @relation("RelationTo")
  examTags           ExamQuestionKnowledgeTag[]
  frequency          KnowledgeFrequencySnapshot[]
  knowledgePointMaps KnowledgePointNodeMap[]
  questionTags       QuestionKnowledgeNodeTag[]
  userMasteries      UserKnowledgeMastery[]
  masterySnapshots   UserMasterySnapshot[]
  nodeQuests         UserNodeQuest[]
  StudyTask          StudyTask[]

  @@index([parentId])
  @@index([subject, nodeType])
  @@index([isActive])
}

model KnowledgeRelation {
  id        String                @id @default(cuid())
  fromId    String
  toId      String
  type      KnowledgeRelationType
  createdAt DateTime              @default(now())

  from KnowledgeNode @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   KnowledgeNode @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
  @@index([toId, type])
}

model ExamPaper {
  id         String   @id
  exam       String
  year       Int
  totalScore Int
  source     String?
  createdAt  DateTime @default(now())

  questions ExamQuestion[]

  @@unique([exam, year])
}

model ExamQuestion {
  id           String   @id
  paperId      String
  questionNo   Int
  subject      String
  questionType String
  score        Int?
  summary      String?
  sourceRef    String?
  createdAt    DateTime @default(now())

  paper ExamPaper                  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  tags  ExamQuestionKnowledgeTag[]

  @@unique([paperId, questionNo])
  @@index([subject, questionType])
}

model ExamQuestionKnowledgeTag {
  id              String           @id @default(cuid())
  questionId      String
  knowledgeNodeId String
  role            ExamTagRole
  confidence      Float
  precision       ExamTagPrecision
  taggedBy        ExamTagger
  createdAt       DateTime         @default(now())

  question      ExamQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  knowledgeNode KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id])

  @@unique([questionId, knowledgeNodeId, role])
  @@index([knowledgeNodeId, precision, role])
}

model KnowledgeFrequencySnapshot {
  id                 String             @id @default(cuid())
  knowledgeNodeId    String
  snapshotDate       DateTime
  recent3Frequency   Int
  recent5Frequency   Int
  allTimeEvidence    Int
  primaryScore5y     Int
  trendDirection     TrendDirection
  trendDelta         Float
  evidenceConfidence EvidenceConfidence
  modelVersion       String
  createdAt          DateTime           @default(now())

  knowledgeNode KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id])

  @@unique([knowledgeNodeId, snapshotDate, modelVersion])
  @@index([snapshotDate, modelVersion])
}

// ---- 408 score center: bridge layer ----

model KnowledgePointNodeMap {
  knowledgePointId String
  knowledgeNodeId  String
  mappingType      String     @default("PRIMARY")
  confidence       Float?
  taggedBy         ExamTagger @default(HYBRID)
  createdAt        DateTime   @default(now())

  knowledgePoint KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  knowledgeNode  KnowledgeNode  @relation(fields: [knowledgeNodeId], references: [id], onDelete: Cascade)

  @@id([knowledgePointId, knowledgeNodeId])
  @@index([knowledgeNodeId])
}

model QuestionKnowledgeNodeTag {
  id              String      @id @default(cuid())
  questionId      String
  knowledgeNodeId String
  role            ExamTagRole
  confidence      Float       @default(1.0)
  taggedBy        ExamTagger  @default(HYBRID)
  source          String?
  createdAt       DateTime    @default(now())

  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  knowledgeNode KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id])

  @@unique([questionId, knowledgeNodeId, role])
  @@index([knowledgeNodeId, role])
}

// ---- 408 score center: user atomic mastery state ----

model UserKnowledgeMastery {
  id              String    @id @default(cuid())
  userId          String
  knowledgeNodeId String
  mastery         Float     @default(0.5)
  accuracy        Float     @default(0.55)
  recentAccuracy  Float     @default(0.55)
  attempts        Int       @default(0)
  correctCount    Int       @default(0)
  wrongCount      Int       @default(0)
  retention       Float?
  stabilityDays   Float?
  lastLearnedAt   DateTime?
  lastReviewedAt  DateTime?
  nextReviewAt    DateTime?
  confidence      Float     @default(0.0)
  pinned          Boolean   @default(false)
  version         Int       @default(0)
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeNode KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id])

  @@unique([userId, knowledgeNodeId])
  @@index([userId, nextReviewAt])
}

model UserMasterySnapshot {
  id              String        @id @default(cuid())
  userId          String
  knowledgeNodeId String
  mastery         Float
  attempts        Int
  correctCount    Int
  wrongCount      Int
  snapshotDate    DateTime
  createdAt       DateTime      @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeNode  KnowledgeNode  @relation(fields: [knowledgeNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, knowledgeNodeId, snapshotDate])
  @@index([userId, snapshotDate])
}

model UserNodeQuest {
  id              String     @id @default(cuid())
  userId          String
  knowledgeNodeId String
  attempts        Int        @default(0)
  bestAccuracy    Float      @default(0)
  passed          Boolean    @default(false)
  passedAt        DateTime?
  updatedAt       DateTime   @updatedAt
  createdAt       DateTime   @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeNode KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, knowledgeNodeId])
  @@index([userId, passed])
}
