{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question",
  "type": "object",
  "required": [
    "id",
    "title",
    "subject_id",
    "chapter_id",
    "knowledge_point_ids",
    "question_type",
    "difficulty",
    "stem",
    "answer",
    "analysis",
    "copyright_status",
    "review",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_point_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "stem": {
      "type": "string",
      "minLength": 5
    },
    "analysis": {
      "type": "string",
      "minLength": 5
    },
    "copyright_status": {
      "type": "string",
      "enum": [
        "PUBLIC_OFFICIAL",
        "SELF_CREATED",
        "AUTHORIZED",
        "OPEN_LICENSE",
        "LINK_ONLY",
        "REVIEW_REQUIRED",
        "PROHIBITED"
      ]
    },
    "review": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "self_check",
            "content_review",
            "copyright_review",
            "trial",
            "approved",
            "published",
            "deprecated"
          ]
        }
      }
    },
    "version": {
      "type": "string"
    }
  }
}