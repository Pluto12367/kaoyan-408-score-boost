{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Point",
  "type": "object",
  "required": [
    "id",
    "name",
    "subject_id",
    "chapter_id",
    "definition",
    "difficulty_level",
    "source_ids",
    "status",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string"
    },
    "chapter_id": {
      "type": "string"
    },
    "definition": {
      "type": "string",
      "minLength": 5
    },
    "difficulty_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "self_check",
        "content_review",
        "copyright_review",
        "trial",
        "approved",
        "published",
        "deprecated"
      ]
    },
    "version": {
      "type": "string"
    }
  }
}