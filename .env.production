# ---- Production Environment ----
# Copy to .env and fill in real values. Never commit .env to git.

NODE_ENV=production

# PostgreSQL (required in production)
DATABASE_URL="postgresql://user:password@host:5432/kaoyan408?schema=public"

# JWT secret (required, min 32 chars in production)
JWT_SECRET="replace-with-a-secure-random-string-at-least-32-characters"

# API port
PORT=3000

# Allowed CORS origins (comma-separated)
WEB_ORIGIN="https://your-frontend-domain.com"

# Demo auth (MUST be false in production)
ALLOW_DEMO_AUTH="false"

# Frontend API base URL
VITE_API_BASE_URL="https://your-api-domain.com"
