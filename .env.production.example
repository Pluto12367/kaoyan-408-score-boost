NODE_ENV=production
DATABASE_URL="postgresql://production_user:replace-me@production-db.example.com:5432/kaoyan408?schema=public"
PORT=3000
WEB_ORIGIN="https://app.example.com"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
ALLOW_DEMO_AUTH="false"
AUDIT_LOG_RETENTION_DAYS="90"
QUESTION_IMPORT_DATA_DIR="/var/lib/kaoyan408/question-imports"
# Configure this only in the deployed secret environment. Leaving it blank keeps PDF imports disabled while Excel/CSV imports remain available.
MINERU_API_TOKEN=""
TENCENTCLOUD_SECRET_ID=""
TENCENTCLOUD_SECRET_KEY=""
TENCENTCLOUD_REGION="ap-shanghai"
QUESTION_IMPORT_MAX_PDF_BYTES="524288000"
QUESTION_IMPORT_MAX_PROVIDER_PAGES="200"
QUESTION_IMPORT_TEMPORARY_QUOTA_BYTES="10737418240"
QUESTION_IMPORT_DISK_STOP_PERCENT="80"
NODE_OPTIONS="--max-old-space-size=1536"
VITE_API_BASE_URL="https://api.example.com"
VITE_PUBLIC_BASE_PATH="/"

# Temporary closed pilot only:
# WEB_ORIGIN="http://203.0.113.10"
# VITE_API_BASE_URL="/api"
# ALLOW_INSECURE_HTTP_IP="true"
ALLOW_INSECURE_HTTP_IP="false"

# ---------------------------------------------------------------------------
# G1 Guidance Foundation — student-visible behaviour switches
# ---------------------------------------------------------------------------
# These three flags decide student-visible semantics and were previously
# undiscoverable from any template (they defaulted silently).
#
# G1.7 (owner decision A5 = APPROVED): the transfer re-test capability is shipped,
# but PRODUCTION ENABLE IS OFF (G1 Release Hardening owner decision) because
# `transfer_probe_pool` currently contains 0 questions. Enabling it would run the
# intervention -> scheduled -> delivery chain and then honestly report
# `no_probe_available` for every student, i.e. expose a flow with nothing to
# deliver. Keep this OFF until the content task ships the probe pool
# (30 nodes x 2+ verified isomorphic questions), then set it to "true".
TRANSFER_PROBE_ENABLED="false"
# Mastery semantics: leave unset or set to `legacy`. `c1` is a separately
# approved migration candidate and MUST remain OFF (no observable benefit was
# demonstrated; it is defensive only). Do not enable it here.
# MASTERY_SEMANTICS="legacy"
# Knowledge-node mastery read path. Unset = OFF (legacy read path).
# USE_KNODE_MASTERY="false"
