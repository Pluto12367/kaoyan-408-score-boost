NODE_ENV=production
DATABASE_URL="postgresql://production_user:replace-me@production-db.example.com:5432/kaoyan408?schema=public"
PORT=3000
WEB_ORIGIN="https://app.example.com"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
ALLOW_DEMO_AUTH="false"
AUDIT_LOG_RETENTION_DAYS="90"
QUESTION_IMPORT_DATA_DIR="/var/lib/kaoyan408/question-imports"
# Configure this only in the deployed secret environment. Leaving it blank keeps PDF imports disabled while Excel/CSV imports remain available.
MINERU_API_TOKEN=""
TENCENTCLOUD_SECRET_ID=""
TENCENTCLOUD_SECRET_KEY=""
TENCENTCLOUD_REGION="ap-shanghai"
QUESTION_IMPORT_MAX_PDF_BYTES="524288000"
QUESTION_IMPORT_TEMPORARY_QUOTA_BYTES="10737418240"
QUESTION_IMPORT_DISK_STOP_PERCENT="80"
NODE_OPTIONS="--max-old-space-size=1536"
VITE_API_BASE_URL="https://api.example.com"
VITE_PUBLIC_BASE_PATH="/"

# Temporary closed pilot only:
# WEB_ORIGIN="http://203.0.113.10"
# VITE_API_BASE_URL="/api"
# ALLOW_INSECURE_HTTP_IP="true"
ALLOW_INSECURE_HTTP_IP="false"
