NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaoyan408?schema=public"
PORT=3000
WEB_ORIGIN="http://localhost:5173"
JWT_SECRET="local-development-secret-at-least-32-characters"
ALLOW_DEMO_AUTH="true"
AUDIT_LOG_RETENTION_DAYS="30"
VITE_API_BASE_URL="http://127.0.0.1:3000"
VITE_PUBLIC_BASE_PATH="/"
# Optional DeepSeek AI tutor (stage 7). Leave AI_API_KEY empty to keep the
# template-based tutor reply; real model calls require a DeepSeek API key.
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_BASE_URL=https://api.deepseek.com
AI_TIMEOUT_MS=25000
AI_MAX_TOKENS=2000
